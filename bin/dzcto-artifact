#!/usr/bin/env sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PY_SCRIPT="$SCRIPT_DIR/../scripts/dzcto_artifact.py"

if command -v python3 >/dev/null 2>&1; then
  exec python3 "$PY_SCRIPT" "$@"
fi

echo "Day Zero CTO requires python3 to run dzcto-artifact. Install Python 3.10+ or use an agent/runtime that provides it." >&2
exit 127
